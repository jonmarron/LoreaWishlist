# Copy to .env.local for local development.
#
# All of these are compiled into the browser bundle and are readable by every
# visitor. That is fine and intended: the Supabase URL and anon key identify
# the project, they do not grant access to it. What anyone is allowed to do is
# decided by the row-level security policies in supabase/schema.sql, which
# Postgres enforces.
#
# Supabase dashboard -> Project Settings -> API (or "API Keys").

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Who may administer the list is stored in the `admins` table in Postgres,
# not here. Add an admin by inserting their email there.

# Only for a GitHub Pages *project* site: the repo name with a leading slash,
# e.g. /wishlist. Leave empty locally and for a user/org site at the root.
BASE_PATH=
